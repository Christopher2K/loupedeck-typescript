{
  "name": "loupedeck",
  "version": "7.2.1",
  "description": "Loupedeck Device Interface",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "biome check --write --unsafe",
    "lint": "biome check .",
    "prepack": "npm run build",
    "test": "npm run build && node --test --experimental-test-coverage --experimental-test-module-mocks",
    "test:types": "npm run build && tsc -p tsconfig.test-types.json"
  },
  "allowScripts": {
    "canvas": true
  },
  "files": [
    "index.js",
    "device.js",
    "discovery.js",
    "constants.js",
    "parser.js",
    "util.js",
    "*.d.ts",
    "connections/*.js",
    "connections/*.d.ts"
  ],
  "dependencies": {
    "@types/node": "^26.6.6",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/ws": "^8.18.2",
    "canvas": "^3.2.3",
    "color-rgba": "^3.1.1",
    "serialport": "^13.0.0",
    "strict-event-emitter": "^0.5.1",
    "ws": "^8.22.0"
  },
  "keywords": [
    "loupedeck",
    "device",
    "hardware",
    "interface",
    "controller",
    "websocket"
  ],
  "browser": {
    "serialport": false,
    "ws": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxxyz/loupedeck.git"
  },
  "author": "Ivo Janssen <hello@ivo.la>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "^7.0.2"
  }
}
